{
  "name": "medichain-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Patient-controlled medical records portfolio MVP",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node backend/dist/server.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc --project backend/tsconfig.json --noEmit",
    "typecheck:frontend": "node ./node_modules/typescript/bin/tsc --project frontend/tsconfig.json --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run --config backend/vitest.config.ts",
    "test:frontend": "node ./node_modules/vitest/vitest.mjs run --config frontend/vite.config.ts",
    "test:all": "npm run test && npm run test:frontend",
    "build": "node ./node_modules/typescript/bin/tsc --project backend/tsconfig.json",
    "build:frontend": "npm --prefix frontend run build",
    "seed": "node ./node_modules/tsx/dist/cli.mjs backend/scripts/seed.ts",
    "verify:audit": "node ./node_modules/tsx/dist/cli.mjs backend/scripts/verify-audit.ts",
    "dev:backend": "node ./node_modules/tsx/dist/cli.mjs watch backend/src/server.ts",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {}
}
